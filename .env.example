GEMINI_API_KEY=
GEMINI_TEXT_MODEL=           # set from the provider docs; no model ID is hard-coded
GEMINI_VISION_MODEL=
GEMINI_IMAGE_MODEL=
# Reviewer A: GPT-OSS served through Groq's OpenAI-compatible API.
GROQ_API_KEY=              # Groq: console.groq.com → API Keys
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
DEMO_ACCESS_CODE=            # required in production; dev falls back to "brandgate2026"
DEMO_TODAY=2026-10-24
DAILY_CALL_BUDGET=400
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STORAGE_MODE=        # optional: "supabase" to use the server-proxied Supabase store (falls back to browser storage)
RATE_LIMIT_PER_MINUTE=20        # LLM requests per client IP per minute
# Optional, scripts only: pace batch runs under free-tier limits
GROQ_TOKENS_PER_MINUTE=
GEMINI_TOKENS_PER_MINUTE=
NVIDIA_TOKENS_PER_MINUTE=
