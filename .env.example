# =============================================================================
# Groq API Configuration (3 Separate Keys & Models)
# Obtain keys at: https://console.groq.com/keys
# =============================================================================

# Groq Slot 1: Primary Drafter & Generator (Build, Fixes, Clarify, Baseline, Intent, Perceive)
GROQ_API_KEY_1=
GROQ_MODEL_1=openai/gpt-oss-120b
GROQ_BASE_URL_1=https://api.groq.com/openai/v1

# Groq Slot 2: Reviewer A (Independent Policy, Tone, and Terminology Review)
GROQ_API_KEY_2=
GROQ_MODEL_2=openai/gpt-oss-20b
GROQ_BASE_URL_2=https://api.groq.com/openai/v1

# Groq Slot 3: Reviewer B & Cross-Check (Second Auditor & Debate Cross-Examiner)
GROQ_API_KEY_3=
GROQ_MODEL_3=qwen/qwen3.8-27b
GROQ_BASE_URL_3=https://api.groq.com/openai/v1

# =============================================================================
# Application Settings
# =============================================================================
DEMO_ACCESS_CODE=            # required in production; dev falls back to "brandgate2026"
DEMO_TODAY=2026-10-24
DAILY_CALL_BUDGET=400
RATE_LIMIT_PER_MINUTE=20        # LLM requests per client IP per minute

# Optional Server Storage (Supabase / Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STORAGE_MODE=        # optional: "supabase" to use server-proxied Supabase store

# Optional, scripts only: pace batch runs under free-tier limits
GROQ_TOKENS_PER_MINUTE=
